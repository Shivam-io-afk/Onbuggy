# ==========================================
# Onbuggy Client - Environment Variables
# ==========================================

# When deploying on Vercel, set these in Project Settings -> Environment Variables:

# Production Render.com backend API URL
VITE_API_URL=https://onbuggy-server.onrender.com/api

# Production Render.com WebSocket URL (same domain as backend)
VITE_SOCKET_URL=https://onbuggy-server.onrender.com

# Optional: Google Maps JavaScript API Key (if using native JS SDK)
VITE_GOOGLE_MAPS_API_KEY=

