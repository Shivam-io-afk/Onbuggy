# ==============================================================================
# ONBUGGY SERVER ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/onbuggy?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here_64_chars_min
JWT_EXPIRE=30d
CLIENT_URL=https://your-onbuggy.vercel.app

# Render.com Anti-Sleep Configuration
RENDER_EXTERNAL_URL=https://your-service.onrender.com
KEEP_ALIVE_URL=https://your-service.onrender.com
KEEP_ALIVE_INTERVAL_MINS=10
