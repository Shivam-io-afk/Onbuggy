# ==============================================================================
# ONBUGGY MASTER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION (server/)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/onbuggy
JWT_SECRET=replace_with_your_super_secret_jwt_key_here
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. RENDER.COM ANTI-SLEEP CONFIGURATION
# ------------------------------------------------------------------------------
RENDER_EXTERNAL_URL=https://your-service.onrender.com
KEEP_ALIVE_URL=https://your-service.onrender.com
KEEP_ALIVE_INTERVAL_MINS=10

# ------------------------------------------------------------------------------
# 3. CLIENT CONFIGURATION (client/)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_GOOGLE_MAPS_API_KEY=
